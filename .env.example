PORT=8080
DATABASE_URL=postgres://civicfix:civicfix@localhost:5432/civicfix?sslmode=disable
# Timezone for per-day statistics (dashboard trend)
APP_TIMEZONE=Asia/Kolkata
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Map fallback when the user's location is unavailable
DEFAULT_CITY_NAME=New Delhi
DEFAULT_CITY_LAT=28.6139
DEFAULT_CITY_LNG=77.2090

# Area search is limited to these countries (ISO codes, comma-separated; empty = worldwide)
SEARCH_COUNTRY_CODES=in
# Sent to OpenStreetMap Nominatim for reverse geocoding (city name lookup)
NOMINATIM_USER_AGENT=CivicFix/0.1 (local development)

# Uploaded photos are stored here
UPLOAD_DIR=uploads
# Secret key used to hash Aadhaar numbers (the full number is never stored).
# Generate one with:  openssl rand -hex 32   and keep it private.
AADHAAR_HASH_KEY=

# First admin account (created on first start if no admin exists).
# If ADMIN_PASSWORD is empty, a random one is generated and printed once.
ADMIN_EMAIL=admin@civicfix.local
ADMIN_PASSWORD=
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
